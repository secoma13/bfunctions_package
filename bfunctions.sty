\NeedsTexFormat{LaTeX2e}
\ProvidesPackage{bfunctions}[]

\RequirePackage{xcolor}
\RequirePackage{keyval} % used to handle options passed to the package
\RequirePackage[most]{tcolorbox}
\RequirePackage{amsfonts}
\tcbuselibrary{skins}

\definecolor{darkred}{HTML}{9C1E07}

% language flags (initially false)
\newif\if@spanish
\newif\if@english
\newif\if@french

% math font flags (initially false)
\newif\if@bold
\newif\if@mathb

% Handle languages
% Raise error if both languages are set as inputs
\DeclareOption{spanish}{
    \if@english 
        \PackageError{bfunctions}{Cannot call bfunctions with two or more language options at the same time}
    \else\if@french
        \PackageError{bfunctions}{Cannot call bfunctions with two or more language options at the same time}
    \fi
    \@spanishtrue
}

\DeclareOption{english}{
    \if@spanish
        \PackageError{bfunctions}{Cannot call bfunctions with two or more language options at the same time}
    \else\if@french
        \PackageError{bfunctions}{Cannot call bfunctions with two or more language options at the same time}
    \fi
    \@englishtrue
}

\DeclareOption{french}{
    \if@english
        \PackageError{bfunctions}{Cannot call bfunctions with two or more language options at the same time}
    \else\if\@spanish
        \PackageError{bfunctions}{Cannot call bfunctions with two or more language options at the same time}
    \fi
    \@frenchtrue
}

% Defaults to english
\ExecuteOptions{english}

% Handle math fonts
\DeclareOption{mathb}{
    \if@bold
        \PackageError{bfunctions}{Cannot call bfunctions with two or more math font options at the same time}
    \fi
    \@mathbtrue
}

\DeclareOption{bold}{
    \if@mathb
        \PackageError{bfunctions}{Cannot call bfunctions with two or more math font options at the same time}
    \fi
    \@boldtrue
}



% --------------------------------
% Common parenthesis and brackets
% ---------------------------------
\newcommand{\parent}[1]{
    \left( #1 \right)
}

\newcommand{\corch}[1]{
    \left\{ #1 \right\}
}

\newcommand{\sqparent}[1]{
    \left[ \right]
}

\newcommand{\abs}[1]{
\left| #1 \right|
}

\newcommand{\norm}[1]{
\left\lVert #1 \right\rVert
}

% ------------------------------------
% Special leters for common sets
% ------------------------------------

\if@mathb
    \newcommand{\R}[0]{\mathbb{R}}
    \newcommand{\N}[0]{\mathbb{N}}
    \newcommand{\Z}[0]{\mathbb{Z}}
    \newcommand{\Q}[0]{\mathbb{Q}}
    \newcommand{\K}[0]{\mathbb{K}}
    \newcommand{\C}[0]{\mathbb{C}}
    \renewcommand{\S}{\mathbb{S}}
    \newcommand{\H}[0]{\mathbb{H}}
    \newcommand{\T}[0]{\mathbb{T}}
\else
    \newcommand{\R}[0]{\mathbf{R}}
    \newcommand{\N}[0]{\mathbf{N}}
    \newcommand{\Z}[0]{\mathbf{Z}}
    \newcommand{\Q}[0]{\mathbf{Q}}
    \newcommand{\K}[0]{\mathbf{K}}
    \newcommand{\C}[0]{\mathbf{C}}
    \renewcommand{\S}{\mathbf{S}}
    \newcommand{\H}[0]{\mathbf{H}}
    \newcommand{\T}[0]{\mathbf{T}}
\fi    
    

% ---------------------------------------------------
%  Symbols for differentials and derivatives
% ---------------------------------------------------
\newcommand{\diff}[0]{
    \mathrm{d} \hspace{2 pt}
}

% Render derivative at a point
\newcommand{\derivpoint}[3]{
    \left.\frac{\diff #1}{\diff #2}\right|_{#3}
}

\newcommand{\deriv}[2]{
    \frac{\diff #1}{\diff #2} 
}

\newcommand{\derpar}[2]{
    \frac{\partial #1}{\partial #2}
}

\newcommand{\derparn}[3]{
    \frac{\diff ^{#3} #1}{\diff #2^{#3}}
}

\newcommand{\derparnpoint}[4]{
    \left.\frac{\diff ^{#3} #1}{\diff #2^{#3}}\right|_{#4}
}

\newcommand{\derparpoint}[2]{
    \left. \frac{\partial #1}{\partial #2} \right|_{#3}
}

\newcommand{\eval}[2]{
\left. #1 \right|_{#2}
}

% -----------------------------------------------------------
% Quickly acces accent colors
% ------------------------------------------------------------ç

\if@english
    \newcommand{\Solution}[1]{{\color{blue}\textbf{Solution:} #1}}
\else\if@french
    \newcommand{\Solution}[1]{{\color{blue}\textbf{Solution:} #1}}
\else\if@spanish
    \newcommand{\Solution}[1]{{\color{blue}\textbf{Solución:} #1}}

\newcommand{\Highlight}[1]{
    {\color{darkred} 
    \textbf{#1}
    }
}

% --------------------------------------------------------------
% stars
% --------------------------------------------------------------
\newcommand{\OneStar}[0]{
    ({\color{red}\star})
}

\newcommand{\TwoStars}[0]{
    (\color{red}\star\star)
}

% -----------------------------------------------------------
% To put nice boxes around theorems and propositions
% to see the result, check the pdf at my other repository: https://github.com/secoma13/TFM/blob/main/main.pdf
% -----------------------------------------------------------

\theoremstyle{definition} % statements of theorems do not render in italics

% Definitions for theorems, propositions, definitions etc
\if@english
    \newtheorem{theorem}{Theorem}[chapter]
    \newtheorem{definition}[theorem]{Definition}
    \newtheorem{corollary}[theorem]{Corollary}
    \newtheorem{prop}[theorem]{Proposition}
    \newtheorem{lemma}[theorem]{Lemma}
    \newtheorem{example}[theorem]{Example}
    \newtheorem{obs}[theorem]{Remark}
    \newtheorem{nota}[theorem]{Notation}

\else\if@french
    \theoremstyle{definition}
    \newtheorem{theorem}{Théorème}[chapter]
    \newtheorem{definition}[theorem]{Definition}
    \newtheorem{corollary}[theorem]{Corollaire}
    \newtheorem{prop}[theorem]{Proposition}
    \newtheorem{lemma}[theorem]{Lemme}
    \newtheorem{example}[theorem]{Exemple}
    \newtheorem{obs}[theorem]{Remarque}
    \newtheorem{nota}[theorem]{Notation}

\else\if@spanish
    \theoremstyle{definition}
    \newtheorem{theorem}{Teorema}[chapter]
    \newtheorem{definition}[theorem]{Definición}
    \newtheorem{corollary}[theorem]{Corolario}
    \newtheorem{prop}[theorem]{Proposición}
    \newtheorem{lemma}[theorem]{Lema}
    \newtheorem{example}[theorem]{Ejemplo}
    \newtheorem{obs}[theorem]{Observación}
    \newtheorem{nota}[theorem]{Notación}
\fi


\NewTotalTColorBox[]{\Bluebox}{ +m }{ 
    notitle,
    colback=teal!5!white,
    frame hidden,
    boxrule=0pt,
    enhanced,
    sharp corners,
    borderline west={4pt}{0pt}{teal!50!black},
}{
    #1
}

\NewTotalTColorBox[]{\Yellowbox}{ +m }{ 
    notitle,
    colback=Goldenrod!5!white,
    frame hidden,
    boxrule=0pt,
    enhanced,
    sharp corners,
    borderline west={4pt}{0pt}{Goldenrod!85!black},
}{
    #1
}


\NewTotalTColorBox[]{\Redbox}{ +m }{ 
    notitle,
    colback=Mahogany!5!white,
    frame hidden,
    boxrule=0pt,
    enhanced,
    sharp corners,
    borderline west={4pt}{0pt}{Mahogany!85!black},
}{
    #1
}

\NewTotalTColorBox[]{\Greenbox}{ +m }{ 
    notitle,
    colback=ForestGreen!5!white,
    frame hidden,
    boxrule=0pt,
    enhanced,
    sharp corners,
    borderline west={4pt}{0pt}{ForestGreen!85!black},
}{
    #1
}

\newcommand{\BoxDefinition}[2]{
\Bluebox{\begin{definition}[#1]
#2
\end{definition}}
}

\newcommand{\BoxTheorem}[2]{
\Yellowbox{\begin{theorem}[#1]
#2
\end{theorem}}
}

\newcommand{\BoxProposition}[2]{
\Redbox{\begin{prop}[#1]
#2
\end{prop}}
}

\newcommand{\BoxLemma}[2]{
\Greenbox{\begin{lemma}[#1]
#2
\end{lemma}}
}


